# Comparison operators for int
10 < 10;
10 <= 10;
10 == 10;
10 != 10;
10 >= 10;
10 > 10;

9 < 10;
9 <= 10;
9 == 10;
9 != 10;
9 >= 10;
9 > 10;

10 < 9;
10 <= 9;
10 == 9;
10 != 9;
10 >= 9;
10 > 9;

# Comparison operators for float
10.5 < 10.5;
10.5 <= 10.5;
10.5 == 10.5;
10.5 != 10.5;
10.5 >= 10.5;
10.5 > 10.5;

9.5 < 10.5;
9.5 <= 10.5;
9.5 == 10.5;
9.5 != 10.5;
9.5 >= 10.5;
9.5 > 10.5;

10.5 < 9.5;
10.5 <= 9.5;
10.5 == 9.5;
10.5 != 9.5;
10.5 >= 9.5;
10.5 > 9.5;

# Comparison operators for bool; any others will give a type error
false == false;
false != false;

false == true;
false != true;

true == false;
true != false;

true == true;
true != true;

# Type errors for bool
# false < false;
# false <= false;
# false >= false;
# false > false;

# Comparison operators for char
'a' < 'a';
'a' <= 'a';
'a' == 'a';
'a' != 'a';
'a' >= 'a';
'a' > 'a';

'a' < 'b';
'a' <= 'b';
'a' == 'b';
'a' != 'b';
'a' >= 'b';
'a' > 'b';

'b' < 'a';
'b' <= 'a';
'b' == 'a';
'b' != 'a';
'b' >= 'a';
'b' > 'a';
