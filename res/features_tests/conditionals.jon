let initial: char = 'A';

# If with a value must have an else branch
let i: int = if initial == 'A' {
    let x: int = 6;
    let y: int = 10;
    x - y
} else if initial == 'B' {
    2
} else {
    0
};

# If without a value doesn't need an else branch
if initial == 'C' {
    0;
}

if initial == 'D' {}
else if false {}

# If without a value has type monostate and can be assigned even without an else branch
let no_value = if true {};
no_value; # {}

# Errors
# Condition is not bool
# if 0 {}

# Incompatible types
# if true {
#     0
# } else if true {
#     0.0
# } else if true {
#     false
# } else {
#     'a'
# }

# if with a value but with no else branch
# if true {
#     0
# }
