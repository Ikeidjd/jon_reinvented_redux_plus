let initial: char = 'A';

# If with a value must have an else clause
let i: int = if initial == 'A' {
    let x: int = 6;
    let y: int = 10;
    x - y
} else if initial == 'B' {
    2
} else {
    0
};

# Error: if with a value but with no else clause
# if true {
#     0
# }

# If without a value doesn't need an else clause
if initial == 'C' {
    0;
}

if initial == 'D' {}
else if false {}

# If without a value has type monostate and can be assigned even without an else clause
let no_value = if true {};
no_value; # {}
